{
  "get": {
    "tags": [
      "Voices"
    ],
    "summary": "Get voice clones",
    "description": "Retrieve the saved voices (\"My voices\") of your organization. Use a voice `id` as `voiceId` in `PUT /v1/projects/{projectId}/recordings/{recordingId}/speakers` to dub a speaker with it. Creating a voice needs a recorded consent and is only possible in Studio.",
    "operationId": "getVoiceClones",
    "security": [
      {
        "apiKeyAuth": []
      },
      {
        "bearerAuth": []
      }
    ],
    "parameters": [
      {
        "name": "search",
        "in": "query",
        "required": false,
        "description": "Only voices whose name or description contains this text.",
        "schema": {
          "type": "string"
        }
      },
      {
        "name": "projectId",
        "in": "query",
        "required": false,
        "description": "Only voices made from this project.",
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      }
    ],
    "responses": {
