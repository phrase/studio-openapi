                  "items": {
                    "$ref": "../schemas/VoiceClone.json"
                  }
                },
                "pagination": {
                  "$ref": "../schemas/Pagination.json"
                }
              },
              "required": [
                "data",
                "pagination"
              ]
            },
            "examples": {
              "example": {
                "summary": "Example",
                "value": {
                  "data": [
                    {
                      "id": "6f1d2c3e-8b4a-4c5d-9e7f-123456789abc",
                      "name": "Narrator",
                      "description": null,
                      "gender": "female",
                      "tags": [
                        "narration"
                      ],
                      "projectId": null,
                      "projectName": null,
                      "source": "UPLOAD",
                      "previewUrl": "https://example.com/preview.mp3",
                      "createdAt": "2026-01-01T00:00:00.000Z",
                      "updatedAt": "2026-01-01T00:00:00.000Z"
                    }
                  ],
                  "pagination": {
                    "page": 1,
                    "pageSize": 1,
                    "total": 1,
                    "totalPages": 1
                  }
                }
              }
            }
          }
        }
