{
  "put": {
    "tags": [
      "Dubbing audio"
    ],
    "summary": "Replace the background audio",
    "description": "Upload a new background audio (music and effects) for a dubbing language. Send `multipart/form-data` with `language` and `file`: MP3, WAV or M4A, at most 300 MB. A file of another type, or a larger one, is refused with `400`. Needs write access to the dubbing step of the language. Returns links to the new background audio.",
    "operationId": "replaceBackgroundAudio",
    "security": [
      {
        "apiKeyAuth": []
      },
      {
        "bearerAuth": []
      }
    ],
    "parameters": [
      {
        "name": "projectId",
        "in": "path",
        "required": true,
        "description": "Project ID.",
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      },
      {
        "name": "recordingId",
        "in": "path",
        "required": true,
        "description": "Recording ID.",
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      }
    ],
    "requestBody": {
      "required": true,
      "content": {
        "multipart/form-data": {
          "schema": {
            "$ref": "../schemas/BackgroundAudioUpload.json"
          }
        }
      }
    },
    "responses": {
      "200": {
        "description": "Background audio replaced",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "../schemas/BackgroundAudioResponse.json"
            },
            "examples": {
              "example": {
                "summary": "Example",
                "value": {
                  "backgroundAudioUrl": "https://storage.googleapis.com/bucket/bg.mp3?X-Goog-Signature=...",
                  "backgroundWaveformUrl": "https://storage.googleapis.com/bucket/bg.json?X-Goog-Signature=..."
                }
              }
            }
          }
        }
      },
      "400": {
        "description": "Bad request: a field is missing, empty or has the wrong type.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "../schemas/ErrorResponse.json"
            },
            "examples": {
              "e400": {
                "summary": "Bad request: a field is missing, empty or has the wrong type.",
                "value": {
                  "statusCode": 400,
                  "message": "name must be a string",
                  "timestamp": "2026-01-01T00:00:00.000Z"
                }
              }
            }
          }
        }
      },
      "401": {
        "description": "Unauthorized (invalid API key).",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "../schemas/ErrorResponse.json"
            },
            "examples": {
              "e401": {
                "summary": "Unauthorized (invalid API key).",
                "value": {
                  "statusCode": 401,
                  "message": "Authorization failed",
                  "timestamp": "2026-01-01T00:00:00.000Z"
                }
              }
            }
          }
        }
      },
      "403": {
        "description": "Forbidden: you may not change this item.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "../schemas/ErrorResponse.json"
            },
            "examples": {
              "e403": {
                "summary": "Forbidden: you may not change this item.",
                "value": {
                  "statusCode": 403,
                  "message": "You are not authorized to modify this item",
                  "timestamp": "2026-01-01T00:00:00.000Z"
                }
              }
            }
          }
        }
      },
      "404": {
        "description": "Not found, or not visible to you.",
        "content": {
