{
  "get": {
    "tags": [
      "Exports"
    ],
    "summary": "Get an export",
    "description": "Check how far an export is. Poll until `status` is `done`, then take `downloadUrl` (valid for three hours), or `failed`, then read `errorMessage`. The `exportId` comes from the answer to `POST .../exports`. A share limited to some steps or languages can only poll an export that it started itself; any other export id answers `404`.",
    "operationId": "getExport",
    "security": [
      {
        "apiKeyAuth": []
      },
      {
        "bearerAuth": []
      }
    ],
    "parameters": [
      {
        "name": "projectId",
        "in": "path",
        "required": true,
        "description": "Project ID.",
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      },
      {
        "name": "recordingId",
        "in": "path",
        "required": true,
        "description": "Recording ID.",
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      },
      {
        "name": "exportId",
        "in": "path",
        "required": true,
        "description": "Export ID from the answer to the export request.",
        "schema": {
          "type": "string"
        }
      }
    ],
    "responses": {
      "200": {
        "description": "Export status",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "../schemas/Export.json"
            },
            "examples": {
              "example": {
                "summary": "Example",
                "value": {
                  "exportId": "es-es_audio",
                  "status": "done",
                  "progress": 100,
                  "downloadUrl": "https://storage.googleapis.com/bucket/file.mp3?X-Goog-Signature=..."
                }
              }
            }
          }
        }
      },
      "404": {
        "description": "No export with this id for this recording, or (for a share limited to some steps or languages) not started by you.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "../schemas/ErrorResponse.json"
            },
            "examples": {
              "e404": {
                "summary": "No export with this id for this recording.",
                "value": {
                  "statusCode": 404,
                  "message": "Status not found",
                  "timestamp": "2026-01-01T00:00:00.000Z"
                }
              }
            }
          }
        }
      },
      "401": {
        "description": "Unauthorized (invalid API key).",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "../schemas/ErrorResponse.json"
            },
            "examples": {
              "e401": {
                "summary": "Unauthorized (invalid API key).",
                "value": {
                  "statusCode": 401,
                  "message": "Authorization failed",
                  "timestamp": "2026-01-01T00:00:00.000Z"
                }
              }
            }
          }
        }
      },
      "403": {
        "description": "Forbidden: you may not change this item.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "../schemas/ErrorResponse.json"
            },
            "examples": {
              "e403": {
                "summary": "Forbidden: you may not change this item.",
                "value": {
                  "statusCode": 403,
                  "message": "You are not authorized to modify this item",
                  "timestamp": "2026-01-01T00:00:00.000Z"
                }
              }
            }
          }
        }
      },
      "500": {
        "description": "Internal server error.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "../schemas/ErrorResponse.json"
            },
            "examples": {
              "e500": {
                "summary": "Internal server error.",
                "value": {
                  "statusCode": 500,
                  "message": "Internal server error",
                  "timestamp": "2026-01-01T00:00:00.000Z"
                }
              }
            }
          }
        }
      }
    }
  }
}
