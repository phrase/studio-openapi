{
  "post": {
    "tags": [
      "Recordings"
    ],
    "summary": "Add a recording",
    "description": "Second step of adding a recording to a project that exists: tell Studio the file is uploaded. The size and length are read from the file itself. A file that is empty, larger than 20 GB, longer than 180 minutes or not readable as audio or video is refused with `400` and removed. Asking twice for the same `recordingId` answers `409`. The recording is queued for transcription: it answers `202` with `statusUrl`, which you poll until `transcription` is `done`. This uses credits. Only files you upload are supported; a link to a web page or to another service is not. Needs unrestricted access to the project.",
    "operationId": "addRecording",
    "security": [
      {
        "apiKeyAuth": []
      },
      {
        "bearerAuth": []
      }
    ],
    "parameters": [
      {
        "name": "projectId",
        "in": "path",
        "required": true,
        "description": "Project ID.",
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      }
    ],
    "requestBody": {
      "required": true,
      "content": {
        "application/json": {
          "schema": {
            "$ref": "../schemas/AddRecordingRequest.json"
          },
          "examples": {
            "interview": {
              "summary": "An English interview",
              "value": {
                "recordingId": "6f1d2c3e-8b4a-4c5d-9e7f-123456789abc",
                "fileName": "interview.mp4",
                "sourceLanguage": "en",
                "expectedLanguages": [
                  "de"
                ]
              }
            }
          }
        }
      }
    },
    "responses": {
      "202": {
        "description": "The recording was added and transcription was queued",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "../schemas/AddedRecording.json"
            },
            "examples": {
              "example": {
                "summary": "Example",
                "value": {
                  "recordingId": "6f1d2c3e-8b4a-4c5d-9e7f-123456789abc",
                  "statusUrl": "/v1/projects/6f1d2c3e-8b4a-4c5d-9e7f-123456789abc/recordings/6f1d2c3e-8b4a-4c5d-9e7f-123456789abc/status"
                }
              }
            }
          }
        }
      },
      "400": {
        "description": "Bad request: a field is missing, empty or has the wrong type.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "../schemas/ErrorResponse.json"
            },
            "examples": {
              "e400": {
                "summary": "Bad request: a field is missing, empty or has the wrong type.",
                "value": {
                  "statusCode": 400,
                  "message": "name must be a string",
                  "timestamp": "2026-01-01T00:00:00.000Z"
                }
              }
            }
          }
        }
      },
      "401": {
        "description": "Unauthorized (invalid API key).",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "../schemas/ErrorResponse.json"
            },
            "examples": {
              "e401": {
                "summary": "Unauthorized (invalid API key).",
                "value": {
                  "statusCode": 401,
                  "message": "Authorization failed",
                  "timestamp": "2026-01-01T00:00:00.000Z"
                }
              }
            }
          }
        }
      },
      "403": {
        "description": "Forbidden: the project does not exist or is not shared with you, or your share of the project does not include this step or language. Also returned when your organization has no credits left (`No remaining minutes available`).",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "../schemas/ErrorResponse.json"
            },
            "examples": {
              "e403": {
                "summary": "Forbidden: you may not change this item.",
                "value": {
                  "statusCode": 403,
                  "message": "You are not authorized to modify this item",
                  "timestamp": "2026-01-01T00:00:00.000Z"
                }
              }
            }
          }
        }
      },
      "409": {
        "description": "Conflict: this recording was already added.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "../schemas/ErrorResponse.json"
            },
            "examples": {
              "e409": {
                "summary": "Conflict: this recording was already added.",
                "value": {
                  "statusCode": 409,
                  "message": "This recording was already added",
                  "timestamp": "2026-01-01T00:00:00.000Z"
                }
              }
            }
          }
        }
      },
      "500": {
        "description": "Internal server error.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "../schemas/ErrorResponse.json"
            },
            "examples": {
              "e500": {
                "summary": "Internal server error.",
                "value": {
                  "statusCode": 500,
                  "message": "Internal server error",
                  "timestamp": "2026-01-01T00:00:00.000Z"
                }
              }
            }
          }
        }
      }
    }
  },
  "get": {
    "tags": [
      "Recordings"
    ],
    "summary": "List the recordings of a project",
    "description": "Lists the recordings of a project in the shape of `recordings` in `GET /v1/projects/{id}`. Anyone with access to the project can read them.",
    "operationId": "getRecordings",
    "security": [
      {
        "apiKeyAuth": []
      },
      {
        "bearerAuth": []
      }
    ],
    "parameters": [
      {
        "name": "projectId",
        "in": "path",
        "required": true,
        "description": "Project ID.",
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      }
    ],
    "responses": {
      "200": {
        "description": "The recordings",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "data": {
                  "type": "array",
                  "description": "Items.",
                  "items": {
                    "$ref": "../schemas/Recording.json"
                  }
                },
                "pagination": {
                  "$ref": "../schemas/Pagination.json"
                }
              },
              "required": [
                "data",
                "pagination"
              ]
            },
            "examples": {
              "example": {
                "summary": "Example",
                "value": {
                  "data": [
                    {
                      "id": "6f1d2c3e-8b4a-4c5d-9e7f-123456789abc",
                      "projectId": "0a1b2c3d-4e5f-4a6b-8c7d-9e0f1a2b3c4d",
                      "name": "interview.mp4",
                      "type": "VIDEO",
                      "extension": "mp4",
                      "sourceLanguage": "en",
                      "expectedLanguages": [],
                      "translationLanguages": [
                        "es-es"
                      ],
                      "dubbingLanguages": [],
                      "numSpeakers": 2,
                      "summaryEnabled": false,
                      "customAttributesEnabled": false,
                      "insightsEnabled": false,
                      "safeCommunicationsEnabled": false,
                      "sourceDuration": 125.4,
                      "duration": 125.4,
                      "fps": 25,
                      "createdAt": "2026-01-01T00:00:00.000Z",
                      "updatedAt": "2026-01-01T00:00:00.000Z"
                    }
                  ],
                  "pagination": {
                    "page": 1,
                    "pageSize": 1,
                    "total": 1,
                    "totalPages": 1
                  }
                }
              }
            }
          }
        }
      },
      "400": {
        "description": "Bad request: an id in the path is not a valid UUID.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "../schemas/ErrorResponse.json"
            },
            "examples": {
              "invalid_id": {
                "summary": "Invalid id",
                "value": {
                  "statusCode": 400,
                  "message": "not-a-uuid does not match the required regex",
                  "timestamp": "2026-01-01T00:00:00.000Z"
                }
              }
            }
          }
        }
      },
      "401": {
        "description": "Unauthorized (invalid API key).",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "../schemas/ErrorResponse.json"
            },
            "examples": {
              "e401": {
                "summary": "Unauthorized (invalid API key).",
                "value": {
                  "success": false,
                  "statusCode": 401,
                  "message": "Authorization failed",
                  "timestamp": "2026-01-01T00:00:00.000Z"
                }
              }
            }
          }
        }
      },
      "403": {
        "description": "Forbidden: you have no access to this project.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "../schemas/ErrorResponse.json"
            },
            "examples": {
              "e403": {
                "summary": "Forbidden: you have no access to this project.",
                "value": {
                  "success": false,
                  "statusCode": 403,
                  "message": "You are not authorized to modify this item",
                  "timestamp": "2026-01-01T00:00:00.000Z"
                }
              }
            }
          }
        }
      },
      "500": {
        "description": "Internal server error.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "../schemas/ErrorResponse.json"
            },
            "examples": {
              "e500": {
                "summary": "Internal server error.",
                "value": {
                  "success": false,
                  "statusCode": 500,
                  "message": "Internal server error",
                  "timestamp": "2026-01-01T00:00:00.000Z"
                }
              }
            }
          }
        }
      }
    }
  }
}
