{
  "patch": {
    "tags": [
      "Insights"
    ],
    "summary": "Update an insight item",
    "description": "Change fields of an item. Send only what changes. Only the owner of the item or a manager of its organization may change it; anyone else is refused with `403`, or with `404` when the item is not visible to them. Defaults of Studio cannot be changed. Returns the insight with all its items.",
    "operationId": "updateInsightItem",
    "security": [
      {
        "apiKeyAuth": []
      },
      {
        "bearerAuth": []
      }
    ],
    "parameters": [
      {
        "name": "id",
        "in": "path",
        "required": true,
        "description": "Insight ID.",
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      },
      {
        "name": "itemId",
        "in": "path",
        "required": true,
        "description": "Item ID, from the `items` of the insight.",
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      }
    ],
    "requestBody": {
      "required": true,
      "content": {
        "application/json": {
          "schema": {
            "$ref": "../schemas/UpdateInsightItemRequest.json"
          },
          "examples": {
            "content": {
              "summary": "Change the prompt",
              "value": {
                "content": "Sum the video up in one sentence."
              }
            }
          }
        }
      }
    },
    "responses": {
      "200": {
        "description": "Item updated",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "../schemas/Insight.json"
            },
            "examples": {
              "example": {
                "summary": "Example",
                "value": {
                  "id": "6f1d2c3e-8b4a-4c5d-9e7f-123456789abc",
                  "name": "Marketing review",
                  "description": "Questions for every video",
                  "active": true,
                  "default": false,
                  "shared": false,
                  "items": [
                    {
                      "id": "0a1b2c3d-4e5f-4a6b-8c7d-9e0f1a2b3c4d",
                      "name": "Tone",
                      "content": "Describe the tone of the video.",
                      "createdAt": "2026-01-01T00:00:00.000Z",
                      "updatedAt": "2026-01-01T00:00:00.000Z"
                    }
                  ],
                  "createdAt": "2026-01-01T00:00:00.000Z",
                  "updatedAt": "2026-01-01T00:00:00.000Z"
                }
              }
            }
          }
        }
      },
      "401": {
        "description": "Unauthorized (invalid API key).",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "../schemas/ErrorResponse.json"
            },
            "examples": {
              "e401": {
                "summary": "Unauthorized (invalid API key).",
                "value": {
                  "statusCode": 401,
                  "message": "Authorization failed",
                  "timestamp": "2026-01-01T00:00:00.000Z"
                }
              }
            }
          }
        }
      },
      "403": {
        "description": "Forbidden: you may not change this item.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "../schemas/ErrorResponse.json"
            },
            "examples": {
              "e403": {
                "summary": "Forbidden: you may not change this item.",
                "value": {
                  "statusCode": 403,
                  "message": "You are not authorized to modify this item",
                  "timestamp": "2026-01-01T00:00:00.000Z"
                }
              }
            }
          }
        }
      },
      "404": {
        "description": "Not found, or not visible to you.",
