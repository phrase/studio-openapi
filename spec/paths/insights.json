  "post": {
    "tags": [
      "Insights"
    ],
    "summary": "Create an insight",
    "description": "Create an insight in your organization. Everyone in the organization can read it; only you and managers can change it. Returns the created item, with its id.",
    "operationId": "createInsight",
    "security": [
      {
        "apiKeyAuth": []
      },
      {
        "bearerAuth": []
      }
    ],
    "requestBody": {
      "required": true,
      "content": {
        "application/json": {
          "schema": {
            "$ref": "../schemas/CreateInsightRequest.json"
          },
          "examples": {
            "insight": {
              "summary": "An insight",
              "value": {
                "name": "Marketing review",
                "description": "Questions for every video"
              }
            }
          }
        }
      }
    },
    "responses": {
      "201": {
        "description": "An insight created",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "../schemas/Insight.json"
            },
            "examples": {
              "example": {
                "summary": "Example",
                "value": {
                  "id": "6f1d2c3e-8b4a-4c5d-9e7f-123456789abc",
                  "name": "Marketing review",
                  "description": "Questions for every video",
                  "active": true,
                  "default": false,
                  "shared": false,
                  "items": [
                    {
                      "id": "0a1b2c3d-4e5f-4a6b-8c7d-9e0f1a2b3c4d",
                      "name": "Tone",
                      "content": "Describe the tone of the video.",
