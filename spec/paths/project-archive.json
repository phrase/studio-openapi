{
  "post": {
    "tags": [
      "Projects"
    ],
    "summary": "Archive a project",
    "description": "Archive a project. Only the owner or a manager of the organization may archive; for anyone else the answer is `404`. Archived projects stay readable and are listed with `status=ARCHIVED`.",
    "operationId": "archiveProject",
    "security": [
      {
        "apiKeyAuth": []
      },
      {
        "bearerAuth": []
      }
    ],
    "parameters": [
      {
        "name": "id",
        "in": "path",
        "required": true,
        "description": "Project ID.",
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      }
    ],
    "responses": {
      "200": {
        "description": "Project archived",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "description": "The archived project.",
              "properties": {
                "id": {
                  "type": "string",
                  "description": "Project ID.",
                  "format": "uuid"
                },
                "archived": {
                  "type": "boolean",
                  "description": "Always true after this call."
                }
              },
              "required": [
                "id",
                "archived"
              ]
            },
            "examples": {
              "example": {
                "summary": "Example",
                "value": {
                  "id": "6f1d2c3e-8b4a-4c5d-9e7f-123456789abc",
                  "archived": true
                }
              }
            }
          }
        }
      },
      "401": {
        "description": "Unauthorized (invalid API key).",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "../schemas/ErrorResponse.json"
            },
            "examples": {
              "e401": {
                "summary": "Unauthorized (invalid API key).",
                "value": {
                  "statusCode": 401,
                  "message": "Authorization failed",
                  "timestamp": "2026-01-01T00:00:00.000Z"
                }
              }
            }
          }
        }
      },
      "404": {
        "description": "Not found, or not visible to you.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "../schemas/ErrorResponse.json"
            },
            "examples": {
              "e404": {
                "summary": "Not found, or not visible to you.",
                "value": {
                  "statusCode": 404,
                  "message": "Not found",
                  "timestamp": "2026-01-01T00:00:00.000Z"
                }
              }
            }
          }
        }
      },
      "500": {
        "description": "Internal server error.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "../schemas/ErrorResponse.json"
            },
            "examples": {
              "e500": {
                "summary": "Internal server error.",
                "value": {
                  "statusCode": 500,
                  "message": "Internal server error",
                  "timestamp": "2026-01-01T00:00:00.000Z"
                }
              }
            }
          }
        }
      }
    }
  }
}
