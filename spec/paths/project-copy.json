{
  "post": {
    "tags": [
      "Projects"
    ],
    "summary": "Copy a project",
    "description": "Copy a project into a new project that you own, named \"<name> (Copy)\", with its recordings, media, subtitles, insights, safe communications, voices and settings. You need unrestricted access to the project: a share limited to some steps or languages is refused with `403`. Returns the id of the copy.",
    "operationId": "copyProject",
    "security": [
      {
        "apiKeyAuth": []
      },
      {
        "bearerAuth": []
      }
    ],
    "parameters": [
      {
        "name": "id",
        "in": "path",
        "required": true,
        "description": "Project ID.",
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      }
    ],
    "responses": {
      "201": {
        "description": "Project copied",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "description": "The new project.",
              "properties": {
                "id": {
                  "type": "string",
                  "description": "ID of the copy.",
                  "format": "uuid"
                }
              },
              "required": [
                "id"
              ]
            },
            "examples": {
              "example": {
                "summary": "Example",
                "value": {
                  "id": "0a1b2c3d-4e5f-4a6b-8c7d-9e0f1a2b3c4d"
                }
              }
            }
          }
        }
      },
      "401": {
        "description": "Unauthorized (invalid API key).",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "../schemas/ErrorResponse.json"
            },
            "examples": {
              "e401": {
                "summary": "Unauthorized (invalid API key).",
                "value": {
                  "statusCode": 401,
                  "message": "Authorization failed",
                  "timestamp": "2026-01-01T00:00:00.000Z"
                }
              }
            }
          }
        }
      },
      "403": {
        "description": "Forbidden: you may not change this item.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "../schemas/ErrorResponse.json"
            },
            "examples": {
              "e403": {
                "summary": "Forbidden: you may not change this item.",
                "value": {
                  "statusCode": 403,
                  "message": "You are not authorized to modify this item",
                  "timestamp": "2026-01-01T00:00:00.000Z"
                }
              }
            }
          }
