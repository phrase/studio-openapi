{
  "post": {
    "tags": [
      "Pronunciations"
    ],
    "summary": "Add a pair",
    "description": "Add a pair to a pronunciation set. Only the owner of the item or a manager of its organization may change it; anyone else is refused with `403`, or with `404` when the item is not visible to them. Defaults of Studio cannot be changed. Returns the set with all its pairs.",
    "operationId": "createPronunciationPair",
    "security": [
      {
        "apiKeyAuth": []
      },
      {
        "bearerAuth": []
      }
    ],
    "parameters": [
      {
        "name": "id",
        "in": "path",
        "required": true,
        "description": "Pronunciation set ID.",
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      }
    ],
    "requestBody": {
      "required": true,
      "content": {
        "application/json": {
          "schema": {
            "$ref": "../schemas/PronunciationPairInput.json"
          },
          "examples": {
            "pair": {
              "summary": "A plain pair",
              "value": {
                "source": "SQL",
                "target": "sequel"
              }
            },
            "ipa": {
              "summary": "An IPA pair",
              "value": {
                "source": "Phrase",
                "target": "freɪz",
                "notation": "ipa"
              }
            }
          }
        }
      }
    },
    "responses": {
      "201": {
        "description": "Pair added",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "../schemas/Pronunciation.json"
            },
            "examples": {
              "example": {
                "summary": "Example",
                "value": {
                  "id": "6f1d2c3e-8b4a-4c5d-9e7f-123456789abc",
                  "name": "Tech terms",
                  "description": "Words our brand says in a fixed way",
                  "active": true,
                  "default": false,
                  "shared": false,
                  "items": [
                    {
                      "id": "0a1b2c3d-4e5f-4a6b-8c7d-9e0f1a2b3c4d",
                      "source": "SQL",
                      "target": "sequel",
                      "notation": "plain",
                      "language": "en"
                    }
                  ],
                  "createdAt": "2026-01-01T00:00:00.000Z",
                  "updatedAt": "2026-01-01T00:00:00.000Z"
                }
              }
            }
          }
        }
      },
      "401": {
        "description": "Unauthorized (invalid API key).",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "../schemas/ErrorResponse.json"
            },
            "examples": {
