              "$ref": "../schemas/Glossary.json"
            },
            "examples": {
              "example": {
                "summary": "Example",
                "value": {
                  "id": "6f1d2c3e-8b4a-4c5d-9e7f-123456789abc",
                  "name": "Brand terms",
                  "description": null,
                  "items": "Phrase\nStudio",
                  "active": true,
                  "default": false,
                  "shared": false,
                  "createdAt": "2026-01-01T00:00:00.000Z",
                  "updatedAt": "2026-01-01T00:00:00.000Z"
                }
              }
            }
