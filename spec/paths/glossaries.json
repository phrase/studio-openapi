  "post": {
    "tags": [
      "Glossaries"
    ],
    "summary": "Create a glossary",
    "description": "Create a glossary in your organization. Everyone in the organization can read it; only you and managers can change it. Returns the created item, with its id.",
    "operationId": "createGlossary",
    "security": [
      {
        "apiKeyAuth": []
      },
      {
        "bearerAuth": []
      }
    ],
    "requestBody": {
      "required": true,
      "content": {
        "application/json": {
          "schema": {
            "$ref": "../schemas/CreateGlossaryRequest.json"
          },
          "examples": {
            "glossary": {
              "summary": "A glossary",
              "value": {
                "name": "Brand terms",
                "items": "Phrase\nStudio"
              }
            }
          }
        }
      }
    },
    "responses": {
      "201": {
        "description": "A glossary created",
        "content": {
