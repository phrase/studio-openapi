{
  "post": {
    "tags": [
      "Recordings"
    ],
    "summary": "Get a url to upload a recording",
    "description": "First step of adding a recording to a project that exists: ask where to upload the file. The answer holds a signed url, valid for 30 minutes. `PUT` the file to it with exactly the `headers` it lists; the media goes straight to storage, not through this API. Then call `POST /v1/projects/{projectId}/recordings` with the `recordingId`. The url is for one file of at most 20 GB and 180 minutes; the size limit is part of the signed url, so storage refuses a larger file (and a request without the `x-goog-content-length-range` header) before it is stored. Needs unrestricted access to the project; a share limited to some steps or languages is refused with `403`.",
    "operationId": "createRecordingUploadUrl",
    "security": [
      {
        "apiKeyAuth": []
      },
      {
        "bearerAuth": []
      }
    ],
    "parameters": [
      {
        "name": "projectId",
        "in": "path",
        "required": true,
        "description": "Project ID.",
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      }
    ],
    "requestBody": {
      "required": true,
      "content": {
        "application/json": {
          "schema": {
            "$ref": "../schemas/UploadUrlRequest.json"
          },
          "examples": {
            "video": {
              "summary": "An MP4 video",
              "value": {
                "fileName": "interview.mp4"
              }
            }
          }
        }
      }
    },
    "responses": {
      "200": {
        "description": "Upload url",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "../schemas/UploadUrl.json"
            },
            "examples": {
              "example": {
                "summary": "Example",
                "value": {
                  "recordingId": "6f1d2c3e-8b4a-4c5d-9e7f-123456789abc",
                  "uploadUrl": "https://storage.googleapis.com/bucket/path/file.mp4?X-Goog-Signature=...",
                  "method": "PUT",
                  "headers": {
                    "Content-Type": "video/mp4",
                    "x-goog-content-length-range": "0,21474836480"
                  },
                  "expiresAt": "2026-01-01T00:30:00.000Z",
                  "maxSizeBytes": 21474836480
                }
              }
            }
          }
        }
      },
      "400": {
        "description": "Bad request: a field is missing, empty or has the wrong type.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "../schemas/ErrorResponse.json"
            },
            "examples": {
              "e400": {
                "summary": "Bad request: a field is missing, empty or has the wrong type.",
                "value": {
                  "statusCode": 400,
                  "message": "name must be a string",
                  "timestamp": "2026-01-01T00:00:00.000Z"
                }
              }
            }
          }
        }
      },
      "401": {
        "description": "Unauthorized (invalid API key).",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "../schemas/ErrorResponse.json"
            },
            "examples": {
              "e401": {
                "summary": "Unauthorized (invalid API key).",
                "value": {
                  "statusCode": 401,
                  "message": "Authorization failed",
                  "timestamp": "2026-01-01T00:00:00.000Z"
                }
              }
            }
          }
        }
      },
      "403": {
        "description": "Forbidden: the project does not exist or is not shared with you, or your share of the project does not include this step or language.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "../schemas/ErrorResponse.json"
            },
            "examples": {
              "e403": {
                "summary": "Forbidden: you may not change this item.",
                "value": {
                  "statusCode": 403,
                  "message": "You are not authorized to modify this item",
                  "timestamp": "2026-01-01T00:00:00.000Z"
                }
              }
            }
          }
        }
      },
      "500": {
        "description": "Internal server error.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "../schemas/ErrorResponse.json"
            },
            "examples": {
              "e500": {
                "summary": "Internal server error.",
                "value": {
                  "statusCode": 500,
                  "message": "Internal server error",
                  "timestamp": "2026-01-01T00:00:00.000Z"
                }
              }
            }
          }
        }
      }
    }
  }
}
