  "patch": {
    "tags": [
      "Projects"
    ],
    "summary": "Update Project",
    "description": "Update the settings of a project: the models for translation and insights, the machine translation profile and translation memory, the text-to-speech engine, and the sharing visibility. Which of the machine translation profile and the translation memory apply depends on the translation model, as in Studio: `plai` (Phrase Language AI) takes both, chosen by you; `aita` (AI Translation Agent) takes a translation memory, and Studio chooses its machine translation profile; `gpt-5-mini` and `gpt-4o-mini` take neither. Changing the model keeps the settings that still apply and clears the ones that do not; sending a setting that does not apply is refused with `400`. For `aita` Studio looks up the machine translation profile in your Phrase TMS connection and answers `400` when there is none. The model types follow from the models and are not sent. The endpoint is partial: only fields present in the body are written, so a single field can be changed without resending the rest. Authorization is restricted to the project owner and other accounts in the same organization.\n\nThe same call renames the project with `name`. Updating the settings or renaming is for the owner of the project and managers of the organization; for anyone else the answer is `404`.",
    "operationId": "updateProject",
    "security": [
      {
        "apiKeyAuth": []
      },
      {
        "bearerAuth": []
      }
    ],
    "parameters": [
      {
        "name": "id",
        "in": "path",
        "required": true,
        "description": "Project ID",
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      }
    ],
    "requestBody": {
      "required": true,
      "content": {
        "application/json": {
          "schema": {
            "$ref": "../schemas/UpdateProjectRequest.json"
          },
          "examples": {
            "assign_translation_resources": {
              "summary": "Translate with Phrase Language AI, with a translation memory and an MT profile",
              "value": {
                "translationModelName": "plai",
                "translationMemoryId": "tm-uid-123",
                "mtProfileId": "mt-profile-uid-456"
              }
            },
            "switch_tts_provider": {
              "summary": "Change the TTS provider used for dubbing",
              "value": {
                "ttsProvider": "eleven_v3"
              }
            },
            "change_translation_model": {
              "summary": "Translate with the AI Translation Agent (Studio chooses the MT profile)",
              "value": {
                "translationModelName": "aita",
                "translationMemoryId": "tm-uid-123"
              }
            },
            "share_project": {
              "summary": "Make the project visible to every member of the organization",
              "value": {
                "isPublic": true
              }
            },
            "gpt_model": {
              "summary": "Translate with a GPT model (no MT profile or translation memory)",
              "value": {
                "translationModelName": "gpt-5-mini"
              }
            }
          }
        }
      }
    },
    "responses": {
      "200": {
        "description": "Project updated successfully"
      },
      "400": {
        "description": "Bad Request",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "../schemas/ErrorResponse.json"
            },
            "examples": {
              "bad_request": {
                "summary": "Bad Request",
                "value": {
                  "statusCode": 400,
                  "message": "Bad Request",
                  "timestamp": "2025-01-01T00:00:00.000Z"
                }
              }
            }
          }
        }
      },
      "401": {
        "description": "Unauthorized",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "../schemas/ErrorResponse.json"
            },
            "examples": {
              "unauthorized": {
                "summary": "Unauthorized",
                "value": {
                  "statusCode": 401,
                  "message": "Unauthorized",
                  "timestamp": "2025-01-01T00:00:00.000Z"
                }
              }
            }
          }
        }
      },
      "404": {
        "description": "Project not found",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "../schemas/ErrorResponse.json"
            },
            "examples": {
              "project_not_found": {
