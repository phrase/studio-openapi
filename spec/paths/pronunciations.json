  "post": {
    "tags": [
      "Pronunciations"
    ],
    "summary": "Create a pronunciation set",
    "description": "Create a pronunciation set. With `pairs` the set and all its pairs are created in one call (up to 10000), which is the way to load a whole list before dubbing. Members of the organization can read every item of the organization. Items of other organizations answer `404`. Returns the created set with the ids of its pairs.",
    "operationId": "createPronunciation",
    "security": [
      {
        "apiKeyAuth": []
      },
      {
        "bearerAuth": []
      }
    ],
    "requestBody": {
      "required": true,
      "content": {
        "application/json": {
          "schema": {
            "$ref": "../schemas/CreatePronunciationRequest.json"
          },
          "examples": {
            "bulk": {
              "summary": "A set with its pairs in one call",
              "value": {
                "name": "Tech terms",
                "description": "Words our brand says in a fixed way",
                "pairs": [
                  {
                    "source": "SQL",
                    "target": "sequel",
                    "notation": "plain"
                  },
                  {
                    "source": "nginx",
                    "target": "engine x",
                    "notation": "plain"
                  }
                ]
              }
            }
          }
        }
      }
    },
    "responses": {
      "201": {
        "description": "A pronunciation set created",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "../schemas/Pronunciation.json"
            },
            "examples": {
              "example": {
                "summary": "Example",
                "value": {
                  "id": "6f1d2c3e-8b4a-4c5d-9e7f-123456789abc",
                  "name": "Tech terms",
                  "description": "Words our brand says in a fixed way",
                  "active": true,
                  "default": false,
                  "shared": false,
                  "items": [
                    {
                      "id": "0a1b2c3d-4e5f-4a6b-8c7d-9e0f1a2b3c4d",
                      "source": "SQL",
                      "target": "sequel",
                      "notation": "plain",
                      "language": "en"
                    }
                  ],
                  "createdAt": "2026-01-01T00:00:00.000Z",
                  "updatedAt": "2026-01-01T00:00:00.000Z"
                }
              }
            }
          }
        }
      },
      "400": {
        "description": "Bad request: a field is missing, empty or has the wrong type.",
