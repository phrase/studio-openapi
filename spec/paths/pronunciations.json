{
  "get": {
    "tags": [
      "Pronunciations"
    ],
    "summary": "Get Pronunciations",
    "description": "Retrieve the pronunciation sets of your organization, with their pairs. Members of the organization can read every item of the organization. Items of other organizations answer `404`.",
    "operationId": "getPronunciations",
    "security": [
      {
        "apiKeyAuth": []
      },
      {
        "bearerAuth": []
      }
    ],
    "responses": {
      "200": {
        "description": "Pronunciations retrieved successfully",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "data": {
                  "type": "array",
                  "description": "Pronunciation sets you can use.",
                  "items": {
                    "$ref": "../schemas/Pronunciation.json"
                  }
                },
                "pagination": {
                  "$ref": "../schemas/Pagination.json"
                }
              },
              "required": [
                "data",
                "pagination"
              ]
            },
            "examples": {
              "example": {
                "summary": "Sample response",
                "value": {
                  "data": [
                    {
                      "id": "f983b484-e1b6-439d-8aca-fd9c29181773",
                      "name": "english  greeting",
                      "description": "test",
                      "active": true,
                      "createdAt": "2025-10-13T10:53:12.400Z",
                      "updatedAt": "2025-10-13T10:53:12.400Z",
                      "items": [
                        {
                          "id": "03e75ff0-50f2-493c-a46b-b0f4101e5850",
                          "source": "hello",
                          "target": "onion",
                          "notation": "plain",
                          "language": "en"
                        }
                      ]
                    }
                  ],
                  "pagination": {
                    "page": 1,
                    "pageSize": 1,
                    "total": 1,
                    "totalPages": 1
                  }
                }
              }
            }
          }
        }
      },
      "401": {
        "description": "Unauthorized (invalid API key)",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "../schemas/ErrorResponse.json"
            }
          }
        }
      },
