{
  "get": {
    "tags": [
      "Projects"
    ],
    "summary": "List Projects",
    "description": "List your projects, paged. Without `teamProjects` you get the projects you own; with `teamProjects=true` you get the projects shared with you or public in your organization. Filter by `status` or `search`. Use a returned `id` in the other project endpoints.",
    "operationId": "listProjects",
    "security": [
      {
        "apiKeyAuth": []
      },
      {
        "bearerAuth": []
      }
    ],
    "parameters": [
      {
        "name": "status",
        "in": "query",
        "required": false,
        "description": "Filter by project status. `RECENTLY_COMPLETED` lists the projects that finished a step in the last 24 hours.",
        "schema": {
          "type": "string",
          "enum": [
            "ALL",
            "ARCHIVED",
            "PENDING",
            "IN_PROGRESS",
            "COMPLETED",
            "FAILED",
            "RECENTLY_COMPLETED"
          ],
          "default": "ALL"
        }
      },
      {
        "name": "teamProjects",
        "in": "query",
        "required": false,
        "description": "When true, list team projects — projects shared with you, plus projects made public within your organization (this includes your own public projects). Your own private (unshared) projects are not team projects and are not returned when this flag is set; use the default listing (flag omitted) to retrieve them.",
        "schema": {
          "type": "boolean",
          "default": false
        }
      },
      {
        "name": "search",
        "in": "query",
        "required": false,
        "description": "Free-text search in project name.",
        "schema": {
          "type": "string"
        }
      },
      {
        "name": "page",
        "in": "query",
        "required": false,
        "description": "Page number (min 1).",
        "schema": {
          "type": "integer",
          "minimum": 1,
          "default": 1
        }
      },
      {
        "name": "pageSize",
        "in": "query",
        "required": false,
        "description": "Items per page (1-1000).",
        "schema": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000,
          "default": 1000
        }
      }
    ],
    "responses": {
      "200": {
        "description": "Projects retrieved successfully",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "data": {
                  "type": "array",
                  "description": "Projects on this page.",
                  "items": {
                    "$ref": "../schemas/Project.json"
                  }
                },
                "pagination": {
                  "$ref": "../schemas/Pagination.json"
                }
              },
              "required": [
                "data",
                "pagination"
              ]
            },
            "examples": {
              "example": {
                "summary": "Sample response",
                "value": {
                  "data": [
                    {
                      "id": "3f2b8c1e-5a7d-4e9b-8c6a-1d2e3f4a5b6c",
                      "name": "Meeting Recording",
                      "archived": false,
                      "status": "COMPLETED",
                      "firstRecordingId": "6f1d2c3e-8b4a-4c5d-9e7f-123456789abc",
                      "sourceLanguage": "en",
                      "expectedLanguages": [],
                      "subtitleProfileId": "584ba46d-66f9-48da-9b96-f4ebe1f8fbca",
                      "mediaType": "VIDEO",
                      "duration": 182.4,
                      "fileCount": 1,
                      "recordingTypes": [
                        "TRANSCRIPTION",
                        "TRANSLATION"
                      ],
                      "isPublic": false,
                      "createdAt": "2026-01-12T09:30:00.000Z",
                      "updatedAt": "2026-01-12T09:45:10.000Z"
                    }
                  ],
                  "pagination": {
                    "page": 1,
                    "pageSize": 1000,
                    "total": 1,
                    "totalPages": 1
                  }
                }
              }
            }
          }
        }
      },
      "400": {
        "description": "Bad Request (invalid query parameters)",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "../schemas/ErrorResponse.json"
            },
            "examples": {
              "invalid_query": {
                "summary": "Invalid query",
                "value": {
                  "success": false,
                  "statusCode": 400,
                  "message": "Bad Request",
                  "timestamp": "2025-01-01T00:00:00.000Z"
                }
              }
            }
          }
        }
      },
      "401": {
        "description": "Unauthorized (invalid API key)",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "../schemas/ErrorResponse.json"
            },
            "examples": {
              "invalid_api_key": {
                "summary": "Invalid API key",
                "value": {
                  "success": false,
                  "statusCode": 401,
                  "message": "Unauthorized",
                  "timestamp": "2025-01-01T00:00:00.000Z"
