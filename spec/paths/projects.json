              "expectedLanguages": {
                "description": "Additional languages that may be spoken in the recording besides sourceLanguage (for recordings that switch between languages). Provide as a JSON array string in multipart. sourceLanguage and duplicates are ignored.",
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "subtitleProfiles": {
                "description": "Array of subtitle profile selections. In multipart, provide this as a JSON array string.",
                "type": "array",
                "items": {
                  "$ref": "../schemas/CreateProjectSubtitleProfile.json"
                }
              },
              "summary": {
                "type": "boolean",
                "description": "Enable summary generation"
              },
              "customAttributes": {
                "type": "boolean",
                "description": "Enable custom attributes extraction"
              },
              "insights": {
                "description": "Requested insight IDs (UUID v4). Provide as JSON array or JSON string.",
                "type": "array",
                "items": {
                  "type": "string",
                  "format": "uuid"
                }
              },
              "glossary": {
                "description": "Glossary configuration (JSON object or JSON string). When provided as an object in multipart form, use JSON string representation.",
                "oneOf": [
                  {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string",
                        "format": "uuid",
                        "description": "Existing glossary ID to use for the project"
                      },
                      "content": {
                        "type": "string",
                        "description": "Glossary content as newline-separated terms (e.g., 'term1\\nterm2\\nterm3')"
                      }
                    }
                  },
                  {
                    "type": "string"
                  }
                ]
              },
              "safeCommunications": {
                "description": "Safe communication IDs (UUID v4). Provide as JSON array or JSON string.",
                "type": "array",
                "items": {
                  "type": "string",
                  "format": "uuid"
                }
              },
              "pronunciations": {
                "description": "Pronunciations to apply. In multipart, provide as JSON array string.",
                "type": "array",
                "items": {
                  "$ref": "../schemas/CreateProjectPronunciation.json"
                }
              },
              "fileUrls": {
                "description": "External file URLs to import. Provide as JSON array or JSON string. If provided, uploaded files in this request are ignored for processing (but still count towards the limit of 50 files).",
                "type": "array",
                "items": {
                  "type": "string",
                  "format": "uri"
                }
