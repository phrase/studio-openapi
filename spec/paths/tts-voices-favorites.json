{
  "get": {
    "tags": [
      "Text to speech"
    ],
    "summary": "List favorite voices",
    "description": "The voices your organization marked as favorites for an engine. Everyone in the organization shares the same favorites. ElevenLabs engines share one list.",
    "operationId": "getTtsFavoriteVoices",
    "security": [
      {
        "apiKeyAuth": []
      },
      {
        "bearerAuth": []
      }
    ],
    "parameters": [
      {
        "name": "engine",
        "in": "query",
        "required": false,
        "description": "Engine id from `GET /v1/tts/engines`. Defaults to `eleven_v3`. An engine that is not available to your organization is refused with `400`.",
        "schema": {
          "type": "string"
        }
      }
    ],
    "responses": {
      "200": {
        "description": "Favorite voices",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "../schemas/TtsVoiceDataList.json"
            },
            "examples": {
              "example": {
                "summary": "Example",
                "value": {
                  "data": [
                    {
                      "id": "10NkTYmUabc",
                      "name": "Rachel",
                      "category": "professional",
                      "characteristics": {
                        "gender": "female"
                      },
                      "verifiedLanguages": []
                    }
                  ]
                }
              }
            }
          }
        }
      },
      "400": {
        "description": "Bad request: a field is missing, empty or has the wrong type.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "../schemas/ErrorResponse.json"
            },
            "examples": {
              "e400": {
                "summary": "Bad request: a field is missing, empty or has the wrong type.",
                "value": {
                  "statusCode": 400,
                  "message": "name must be a string",
                  "timestamp": "2026-01-01T00:00:00.000Z"
                }
              }
            }
          }
        }
      },
      "401": {
        "description": "Unauthorized (invalid API key).",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "../schemas/ErrorResponse.json"
            },
            "examples": {
              "e401": {
                "summary": "Unauthorized (invalid API key).",
                "value": {
                  "statusCode": 401,
                  "message": "Authorization failed",
                  "timestamp": "2026-01-01T00:00:00.000Z"
                }
              }
            }
          }
        }
      },
      "500": {
        "description": "Internal server error.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "../schemas/ErrorResponse.json"
            },
            "examples": {
              "e500": {
                "summary": "Internal server error.",
                "value": {
                  "statusCode": 500,
                  "message": "Internal server error",
                  "timestamp": "2026-01-01T00:00:00.000Z"
                }
              }
            }
          }
        }
      }
    }
  },
  "post": {
    "tags": [
      "Text to speech"
    ],
    "summary": "Add a favorite voice",
    "description": "Add a voice to the favorites of your organization. Adding a voice that already is a favorite changes nothing. A voice that does not exist is refused with `404`.",
    "operationId": "addTtsFavoriteVoice",
    "security": [
      {
        "apiKeyAuth": []
      },
      {
        "bearerAuth": []
      }
    ],
    "requestBody": {
      "required": true,
      "content": {
        "application/json": {
          "schema": {
            "$ref": "../schemas/FavoriteVoiceRequest.json"
          },
          "examples": {
            "add": {
              "summary": "Add a voice",
              "value": {
                "voiceId": "10NkTYmUabc",
                "engine": "eleven_v3"
              }
            }
          }
        }
      }
    },
    "responses": {
      "204": {
        "description": "The voice is a favorite."
      },
      "400": {
