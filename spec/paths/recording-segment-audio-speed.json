{
  "put": {
    "tags": [
      "Dubbing audio"
    ],
    "summary": "Change the speed of a segment",
    "description": "Set a new duration for the dubbed audio of one segment, which speeds it up or slows it down. To go back, send `reset: true` with `originalTtsDuration` as `ttsDuration`. Needs write access to the dubbing step of the language. The language must already have generated dubbing audio; otherwise the call is refused with `400` (`Not available for this project`). Returns the segment with a link to its new audio.",
    "operationId": "updateSegmentAudioSpeed",
    "security": [
      {
        "apiKeyAuth": []
      },
      {
        "bearerAuth": []
      }
    ],
    "parameters": [
      {
        "name": "projectId",
        "in": "path",
        "required": true,
        "description": "Project ID.",
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      },
      {
        "name": "recordingId",
        "in": "path",
        "required": true,
        "description": "Recording ID.",
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      }
    ],
    "requestBody": {
      "required": true,
      "content": {
        "application/json": {
          "schema": {
            "$ref": "../schemas/SegmentAudioSpeedRequest.json"
          },
          "examples": {
            "faster": {
              "summary": "10 percent faster",
              "value": {
                "language": "es-es",
                "segmentId": "6f1d2c3e-8b4a-4c5d-9e7f-123456789abc",
                "ttsDuration": 4.5,
                "originalTtsDuration": 5
              }
            }
          }
        }
      }
    },
    "responses": {
      "200": {
        "description": "Speed changed",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "../schemas/SegmentAudioSpeedResponse.json"
            },
            "examples": {
              "example": {
                "summary": "Example",
                "value": {
                  "segmentId": "6f1d2c3e-8b4a-4c5d-9e7f-123456789abc",
                  "url": "https://storage.googleapis.com/bucket/seg.mp3?X-Goog-Signature=..."
                }
              }
            }
          }
        }
      },
      "400": {
        "description": "Bad request: a field is missing, empty or has the wrong type.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "../schemas/ErrorResponse.json"
            },
            "examples": {
              "e400": {
                "summary": "Bad request: a field is missing, empty or has the wrong type.",
                "value": {
                  "statusCode": 400,
                  "message": "name must be a string",
                  "timestamp": "2026-01-01T00:00:00.000Z"
                }
              }
            }
          }
        }
      },
      "401": {
        "description": "Unauthorized (invalid API key).",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "../schemas/ErrorResponse.json"
            },
            "examples": {
              "e401": {
                "summary": "Unauthorized (invalid API key).",
                "value": {
                  "statusCode": 401,
                  "message": "Authorization failed",
                  "timestamp": "2026-01-01T00:00:00.000Z"
                }
              }
            }
          }
        }
      },
      "403": {
        "description": "Forbidden: the project does not exist or is not shared with you, or your share of the project does not include this step or language.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "../schemas/ErrorResponse.json"
            },
            "examples": {
              "e403": {
                "summary": "Forbidden: you may not change this item.",
                "value": {
                  "statusCode": 403,
                  "message": "You are not authorized to modify this item",
                  "timestamp": "2026-01-01T00:00:00.000Z"
                }
              }
            }
          }
        }
      },
      "404": {
        "description": "The recording does not exist in this project.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "../schemas/ErrorResponse.json"
            },
            "examples": {
              "e404": {
                "summary": "Not found, or not visible to you.",
                "value": {
                  "statusCode": 404,
                  "message": "Not found",
                  "timestamp": "2026-01-01T00:00:00.000Z"
                }
              }
            }
          }
        }
      },
      "500": {
        "description": "Internal server error.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "../schemas/ErrorResponse.json"
            },
            "examples": {
              "e500": {
                "summary": "Internal server error.",
                "value": {
                  "statusCode": 500,
                  "message": "Internal server error",
                  "timestamp": "2026-01-01T00:00:00.000Z"
                }
              }
            }
          }
        }
      }
    }
  }
}
