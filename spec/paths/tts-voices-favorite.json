{
  "delete": {
    "tags": [
      "Text to speech"
    ],
    "summary": "Remove a favorite voice",
    "description": "Remove a voice from the favorites of your organization. Removing a voice that is not a favorite changes nothing.",
    "operationId": "removeTtsFavoriteVoice",
    "security": [
      {
        "apiKeyAuth": []
      },
      {
        "bearerAuth": []
      }
    ],
    "parameters": [
      {
        "name": "voiceId",
        "in": "path",
        "required": true,
        "description": "Voice id.",
        "schema": {
          "type": "string"
        }
      },
      {
        "name": "engine",
        "in": "query",
        "required": false,
        "description": "Engine id from `GET /v1/tts/engines`. Defaults to `eleven_v3`. An engine that is not available to your organization is refused with `400`.",
        "schema": {
          "type": "string"
        }
      }
    ],
    "responses": {
