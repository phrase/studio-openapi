  "delete": {
    "tags": [
      "Recordings"
    ],
    "summary": "Delete a speaker",
    "description": "Remove a speaker from a recording. The last speaker of a recording cannot be removed and answers `400`; a speaker that is still assigned to transcription segments answers `409`: assign those segments to another speaker first. Needs write access to the transcription step. Returns the speakers as they are afterwards.",
