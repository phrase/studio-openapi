  "put": {
    "tags": [
      "Recordings"
    ],
    "summary": "Assign voices to speakers",
    "description": "Assign a voice to a speaker for a dubbing language, for example a saved voice from `GET /v1/voices/clones`. The assignment is used the next time that language is dubbed. Needs write access to the dubbing step of every language in the request; a share limited to some languages is refused with `403` for the others. Returns the speakers as they are afterwards.",
    "operationId": "assignSpeakerVoices",
    "security": [
      {
        "apiKeyAuth": []
      },
      {
        "bearerAuth": []
      }
    ],
    "parameters": [
      {
        "name": "projectId",
        "in": "path",
        "required": true,
        "description": "Project ID.",
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      },
      {
        "name": "recordingId",
        "in": "path",
        "required": true,
        "description": "Recording ID.",
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      }
    ],
    "requestBody": {
      "required": true,
      "content": {
        "application/json": {
          "schema": {
            "$ref": "../schemas/AssignSpeakerVoicesRequest.json"
          },
          "examples": {
            "clone": {
              "summary": "Dub Alice with a saved voice",
              "value": {
                "payload": [
                  {
                    "speakerName": "Alice",
                    "language": "es-es",
                    "voiceId": "6f1d2c3e-8b4a-4c5d-9e7f-123456789abc",
                    "provider": "eleven_v3"
                  }
                ]
              }
            }
          }
        }
      }
    },
    "responses": {
      "200": {
        "description": "Voices assigned",
        "content": {
          "application/json": {
            "schema": {
              "type": "array",
              "description": "Speakers.",
              "items": {
                "$ref": "../schemas/RecordingSpeaker.json"
              }
            },
            "examples": {
              "example": {
                "summary": "Example",
                "value": [
                  {
                    "id": "6f1d2c3e-8b4a-4c5d-9e7f-123456789abc",
                    "speakerName": "Alice",
                    "providerVoices": {
                      "eleven_v3": {
                        "es-es": "provider-voice-id"
                      }
                    },
                    "deletable": false
                  }
                ]
              }
            }
          }
        }
      },
      "400": {
        "description": "Bad request: a field is missing, empty or has the wrong type.",
        "content": {
