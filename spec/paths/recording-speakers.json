  "get": {
    "tags": [
      "Recordings"
    ],
    "summary": "Get speakers",
    "description": "Retrieve the speakers of a recording and the voice assigned to each one, per provider and language. Needs read access to the dubbing step.",
    "operationId": "getRecordingSpeakers",
    "security": [
      {
        "apiKeyAuth": []
      },
      {
        "bearerAuth": []
      }
    ],
    "parameters": [
      {
        "name": "projectId",
        "in": "path",
        "required": true,
        "description": "Project ID.",
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      },
      {
        "name": "recordingId",
        "in": "path",
        "required": true,
        "description": "Recording ID.",
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      }
    ],
    "responses": {
      "200": {
        "description": "Speakers retrieved",
        "content": {
          "application/json": {
            "schema": {
              "type": "array",
              "description": "Speakers.",
              "items": {
                "$ref": "../schemas/RecordingSpeaker.json"
              }
            },
            "examples": {
              "example": {
                "summary": "Example",
                "value": [
                  {
                    "id": "6f1d2c3e-8b4a-4c5d-9e7f-123456789abc",
                    "speakerName": "Alice",
                    "providerVoices": {
                      "eleven_v3": {
                        "es-es": "provider-voice-id"
                      }
                    },
                    "deletable": false
                  }
                ]
              }
            }
          }
        }
      },
      "401": {
        "description": "Unauthorized (invalid API key).",
        "content": {
          "application/json": {
