{
  "get": {
    "tags": [
      "Templates"
    ],
    "summary": "Get a template",
    "description": "Retrieve one template. Members of the organization can read every item of the organization. Items of other organizations answer `404`.",
    "operationId": "getTemplate",
    "security": [
      {
        "apiKeyAuth": []
      },
      {
        "bearerAuth": []
      }
    ],
    "parameters": [
      {
        "name": "id",
        "in": "path",
        "required": true,
        "description": "Template ID.",
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      }
    ],
    "responses": {
      "200": {
        "description": "Template retrieved",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "../schemas/Template.json"
            },
            "examples": {
              "example": {
                "summary": "Example",
                "value": {
                  "id": "6f1d2c3e-8b4a-4c5d-9e7f-123456789abc",
                  "name": "Spanish dubbing",
                  "description": "Translate and dub into Spanish",
                  "settings": {
                    "sourceLanguage": "en",
                    "translation": {
                      "languages": [
                        "es-es"
                      ]
                    },
                    "dubbing": {
                      "languages": [
                        "es-es"
                      ]
                    }
                  },
                  "createdAt": "2026-01-01T00:00:00.000Z",
                  "updatedAt": "2026-01-01T00:00:00.000Z"
                }
              }
            }
          }
        }
      },
      "400": {
        "description": "Bad request: an id in the path is not a valid UUID.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "../schemas/ErrorResponse.json"
            },
            "examples": {
              "invalid_id": {
                "summary": "Invalid id",
                "value": {
                  "statusCode": 400,
                  "message": "not-a-uuid does not match the required regex",
                  "timestamp": "2026-01-01T00:00:00.000Z"
                }
              }
            }
          }
        }
      },
      "401": {
        "description": "Unauthorized (invalid API key).",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "../schemas/ErrorResponse.json"
            },
            "examples": {
              "e401": {
                "summary": "Unauthorized (invalid API key).",
                "value": {
                  "statusCode": 401,
                  "message": "Authorization failed",
                  "timestamp": "2026-01-01T00:00:00.000Z"
                }
              }
            }
          }
        }
      },
      "404": {
        "description": "Not found, or not visible to you.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "../schemas/ErrorResponse.json"
            },
            "examples": {
              "e404": {
                "summary": "Not found, or not visible to you.",
                "value": {
                  "statusCode": 404,
                  "message": "Not found",
                  "timestamp": "2026-01-01T00:00:00.000Z"
                }
              }
            }
          }
        }
      },
      "500": {
        "description": "Internal server error.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "../schemas/ErrorResponse.json"
            },
            "examples": {
              "e500": {
                "summary": "Internal server error.",
                "value": {
                  "statusCode": 500,
                  "message": "Internal server error",
                  "timestamp": "2026-01-01T00:00:00.000Z"
                }
              }
            }
          }
        }
      }
    }
  },
  "patch": {
    "tags": [
      "Templates"
    ],
    "summary": "Update a template",
    "description": "Change fields of a template. Send only what changes; `settings` replaces all settings. Only the owner of the template or a manager of the organization may change it; for anyone else the answer is `404`. The new `settings` are checked as when a template is created. `glossaryId`, `subtitleProfileId`, the ids in `translation.subtitleProfiles` and in `dubbing.pronunciations` must be items your organization can see, otherwise the call is rejected with `400` (`<field> refers to something that is not available to your organization: <id>`); the translation `preferences` follow the rules of the project settings (a translation model from the allowed choices, a machine translation profile only with a model that takes one, a translation memory only with a Phrase AI model). Returns the template as it is afterwards.",
    "operationId": "updateTemplate",
    "security": [
      {
        "apiKeyAuth": []
      },
      {
        "bearerAuth": []
      }
    ],
    "parameters": [
      {
        "name": "id",
        "in": "path",
        "required": true,
        "description": "Template ID.",
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      }
    ],
    "requestBody": {
      "required": true,
      "content": {
        "application/json": {
          "schema": {
            "$ref": "../schemas/UpdateTemplateRequest.json"
          },
          "examples": {
            "rename": {
              "summary": "Rename a template",
              "value": {
                "name": "Spanish and French"
              }
            }
          }
        }
      }
    },
    "responses": {
      "200": {
        "description": "Template updated",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "../schemas/Template.json"
            },
            "examples": {
              "example": {
                "summary": "Example",
                "value": {
                  "id": "6f1d2c3e-8b4a-4c5d-9e7f-123456789abc",
                  "name": "Spanish dubbing",
                  "description": "Translate and dub into Spanish",
                  "settings": {
                    "sourceLanguage": "en",
                    "translation": {
                      "languages": [
                        "es-es"
                      ]
                    },
                    "dubbing": {
                      "languages": [
                        "es-es"
                      ]
                    }
                  },
                  "createdAt": "2026-01-01T00:00:00.000Z",
                  "updatedAt": "2026-01-01T00:00:00.000Z"
                }
              }
            }
          }
        }
      },
      "400": {
        "description": "Bad request: a field is missing, empty or has the wrong type.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "../schemas/ErrorResponse.json"
            },
            "examples": {
              "e400": {
                "summary": "Bad request: a field is missing, empty or has the wrong type.",
                "value": {
                  "statusCode": 400,
                  "message": "name must be a string",
                  "timestamp": "2026-01-01T00:00:00.000Z"
                }
              }
            }
          }
        }
      },
      "401": {
        "description": "Unauthorized (invalid API key).",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "../schemas/ErrorResponse.json"
            },
            "examples": {
              "e401": {
                "summary": "Unauthorized (invalid API key).",
                "value": {
                  "statusCode": 401,
                  "message": "Authorization failed",
                  "timestamp": "2026-01-01T00:00:00.000Z"
                }
              }
            }
          }
        }
      },
      "404": {
        "description": "Not found, or not visible to you.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "../schemas/ErrorResponse.json"
            },
            "examples": {
              "e404": {
                "summary": "Not found, or not visible to you.",
                "value": {
                  "statusCode": 404,
                  "message": "Not found",
                  "timestamp": "2026-01-01T00:00:00.000Z"
                }
              }
            }
          }
        }
      },
      "409": {
