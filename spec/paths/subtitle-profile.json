  "patch": {
    "tags": [
      "Subtitle Profiles"
    ],
    "summary": "Update a subtitle profile",
    "description": "Change fields of a subtitle profile. Send only what changes. Your own profile, or a profile of another member when you are a manager of the organization, is changed in place. A default profile of Studio is not changed: the change is stored as a personal copy that replaces the default in your list, and the response is that copy. Anyone else gets `403`. Deleting is not available through the API.",
    "operationId": "updateSubtitleProfile",
    "security": [
      {
        "apiKeyAuth": []
      },
      {
        "bearerAuth": []
      }
    ],
    "parameters": [
      {
        "name": "id",
        "in": "path",
        "required": true,
        "description": "Subtitle profile ID.",
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      }
    ],
    "requestBody": {
      "required": true,
      "content": {
        "application/json": {
          "schema": {
            "$ref": "../schemas/UpdateSubtitleProfileRequest.json"
          },
          "examples": {
            "lines": {
              "summary": "Allow three lines",
              "value": {
                "maxLinesPerScreen": 3
              }
            }
          }
        }
      }
    },
    "responses": {
