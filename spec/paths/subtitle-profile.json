  "delete": {
    "tags": [
      "Subtitle Profiles"
    ],
    "summary": "Delete a subtitle profile",
    "description": "Deletes a subtitle profile of your organization. The owner or an organization manager can delete it; for anyone else the profile is not found. The default profiles that ship with Studio cannot be deleted, they answer `404`: change one with `PATCH` to get your own copy. Projects that used the deleted profile no longer have it.",
    "operationId": "deleteSubtitleProfile",
    "security": [
      {
        "apiKeyAuth": []
      },
      {
        "bearerAuth": []
      }
    ],
    "parameters": [
      {
        "name": "id",
        "in": "path",
        "required": true,
        "description": "Subtitle profile ID.",
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      }
    ],
    "responses": {
      "204": {
        "description": "The subtitle profile was deleted"
      },
      "400": {
        "description": "Bad request: an id in the path is not a valid UUID.",
        "content": {
