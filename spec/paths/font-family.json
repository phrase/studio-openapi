{
  "patch": {
    "tags": [
      "Fonts"
    ],
    "summary": "Rename a font family",
    "description": "Renames a family. The name must be free in your organization. The uploader or an organization manager can rename it; for anyone else the family is not found.",
    "operationId": "renameFontFamily",
    "security": [
      {
        "apiKeyAuth": []
      },
      {
        "bearerAuth": []
      }
    ],
    "parameters": [
      {
        "name": "id",
        "in": "path",
        "required": true,
        "description": "Family ID.",
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      }
    ],
    "requestBody": {
      "required": true,
      "content": {
        "application/json": {
          "schema": {
            "$ref": "../schemas/RenameFontRequest.json"
          },
          "examples": {
            "example": {
              "summary": "Rename",
              "value": {
                "name": "Brand Sans 2"
              }
            }
          }
        }
      }
    },
    "responses": {
      "200": {
        "description": "The renamed family",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "../schemas/FontFamily.json"
            },
            "examples": {
              "example": {
                "summary": "Example",
                "value": {
                  "id": "6f1d2c3e-8b4a-4c5d-9e7f-123456789abc",
                  "name": "Brand Sans",
                  "fontFamily": "custom:6f1d2c3e-8b4a-4c5d-9e7f-123456789abc",
                  "shared": false,
                  "createdAt": "2026-01-01T00:00:00.000Z",
                  "files": [
                    {
                      "id": "0a1b2c3d-4e5f-4a6b-8c7d-9e0f1a2b3c4d",
                      "name": "Brand Sans",
                      "originalFileName": "BrandSans-Regular.ttf",
                      "mimeType": "font/ttf",
                      "fileSize": 148220,
                      "weight": 400,
                      "italic": false,
                      "createdAt": "2026-01-01T00:00:00.000Z"
                    }
                  ]
                }
              }
            }
          }
        }
      },
      "400": {
        "description": "Bad request: a field is missing, empty or has the wrong type, or a file is not a valid font.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "../schemas/ErrorResponse.json"
            },
            "examples": {
              "e400": {
                "summary": "Bad request: a field is missing, empty or has the wrong type, or a file is not a valid font.",
                "value": {
                  "success": false,
                  "statusCode": 400,
                  "message": "Not a valid TTF/OTF font: x.ttf",
                  "timestamp": "2026-01-01T00:00:00.000Z"
                }
              }
            }
          }
        }
      },
      "401": {
        "description": "Unauthorized (invalid API key).",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "../schemas/ErrorResponse.json"
            },
            "examples": {
              "e401": {
                "summary": "Unauthorized (invalid API key).",
                "value": {
                  "success": false,
                  "statusCode": 401,
                  "message": "Authorization failed",
                  "timestamp": "2026-01-01T00:00:00.000Z"
                }
              }
            }
          }
        }
      },
      "404": {
        "description": "Not found, or not visible to you, or you may not manage it.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "../schemas/ErrorResponse.json"
            },
            "examples": {
              "e404": {
                "summary": "Not found, or not visible to you, or you may not manage it.",
                "value": {
                  "success": false,
                  "statusCode": 404,
                  "message": "Font not found",
                  "timestamp": "2026-01-01T00:00:00.000Z"
                }
              }
            }
          }
        }
      },
      "409": {
        "description": "Conflict: the name or the style already exists.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "../schemas/ErrorResponse.json"
            },
            "examples": {
              "e409": {
                "summary": "Conflict: the name or the style already exists.",
                "value": {
                  "success": false,
                  "statusCode": 409,
                  "message": "A font with the name \"Brand Sans\" already exists",
                  "timestamp": "2026-01-01T00:00:00.000Z"
                }
              }
            }
          }
        }
      },
      "500": {
        "description": "Internal server error.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "../schemas/ErrorResponse.json"
            },
            "examples": {
              "e500": {
                "summary": "Internal server error.",
                "value": {
                  "success": false,
                  "statusCode": 500,
                  "message": "Internal server error",
                  "timestamp": "2026-01-01T00:00:00.000Z"
                }
              }
            }
          }
        }
      }
    }
  },
  "delete": {
    "tags": [
      "Fonts"
    ],
    "summary": "Delete a font family",
    "description": "Deletes a family with all its files. Subtitle profiles that still use it fall back to Arial in burned-in video. The uploader or an organization manager can delete it; for anyone else the family is not found.",
    "operationId": "deleteFontFamily",
    "security": [
      {
        "apiKeyAuth": []
      },
      {
        "bearerAuth": []
      }
    ],
    "parameters": [
      {
        "name": "id",
        "in": "path",
        "required": true,
        "description": "Family ID.",
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      }
    ],
    "responses": {
      "204": {
        "description": "The family was deleted"
      },
      "400": {
