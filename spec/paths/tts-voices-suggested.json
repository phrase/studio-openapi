{
  "get": {
    "tags": [
      "Text to speech"
    ],
    "summary": "List suggested voices",
    "description": "Voices Studio suggests for a language. This list exists only for the ElevenLabs engines (`eleven_v2`, `eleven_v3`, `eleven_v4`, `eleven_v4_turbo`); any other engine is refused with `400`. It is the \"Recommended\" tab of Studio.",
    "operationId": "getTtsSuggestedVoices",
    "security": [
      {
        "apiKeyAuth": []
      },
      {
        "bearerAuth": []
      }
    ],
    "parameters": [
      {
        "name": "engine",
        "in": "query",
        "required": false,
        "description": "Engine id from `GET /v1/tts/engines`. Defaults to `eleven_v3`. An engine that is not available to your organization is refused with `400`.",
        "schema": {
          "type": "string",
          "enum": [
            "eleven_v2",
            "eleven_v3",
            "eleven_v4",
            "eleven_v4_turbo",
            "azure_tts",
            "voiseed",
            "gemini_2_5_flash_tts"
          ]
        }
      },
      {
        "name": "language",
        "in": "query",
        "required": true,
        "description": "Language the voices should speak, for example `de`.",
        "schema": {
          "type": "string"
        }
      }
    ],
    "responses": {
      "200": {
        "description": "Suggested voices",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "../schemas/TtsVoiceList.json"
            },
            "examples": {
              "example": {
                "summary": "Example",
                "value": {
                  "data": [
                    {
                      "id": "10NkTYmUabc",
                      "name": "Rachel",
                      "category": "professional",
                      "characteristics": {
                        "gender": "female"
                      },
                      "verifiedLanguages": []
                    }
                  ],
                  "pagination": {
                    "page": 1,
                    "pageSize": 1,
                    "total": 1,
                    "totalPages": 1
                  }
                }
              }
            }
          }
        }
      },
      "400": {
        "description": "Bad request: a field is missing, empty or has the wrong type.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "../schemas/ErrorResponse.json"
            },
            "examples": {
              "e400": {
                "summary": "Bad request: a field is missing, empty or has the wrong type.",
                "value": {
                  "statusCode": 400,
                  "message": "name must be a string",
                  "timestamp": "2026-01-01T00:00:00.000Z"
                }
              }
            }
          }
        }
      },
      "401": {
        "description": "Unauthorized (invalid API key).",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "../schemas/ErrorResponse.json"
            },
            "examples": {
              "e401": {
                "summary": "Unauthorized (invalid API key).",
                "value": {
                  "statusCode": 401,
                  "message": "Authorization failed",
                  "timestamp": "2026-01-01T00:00:00.000Z"
                }
              }
            }
          }
        }
      },
      "500": {
        "description": "Internal server error.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "../schemas/ErrorResponse.json"
            },
            "examples": {
              "e500": {
                "summary": "Internal server error.",
                "value": {
                  "statusCode": 500,
                  "message": "Internal server error",
                  "timestamp": "2026-01-01T00:00:00.000Z"
                }
              }
            }
          }
        }
      }
    }
  }
}
