{
  "type": "object",
  "properties": {
    "suggestions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "segmentId": {
            "type": "string",
            "description": "Id of the segment."
          },
          "originalText": {
            "type": "string",
            "description": "The translation now."
          },
          "suggestedText": {
            "type": "string",
            "description": "The new translation, or `null` when none could be made (see `errorCode`).",
            "nullable": true
          },
          "sourceText": {
            "type": "string",
            "description": "The source text that was translated."
          },
          "errorCode": {
            "type": "string",
            "enum": [
              "SEGMENT_NOT_FOUND",
              "SOURCE_NOT_FOUND",
              "EMPTY_RESPONSE",
              "SAME_TEXT",
              "EXCEPTION"
            ],
            "description": "Why there is no suggestion."
          },
          "errorMessage": {
            "type": "string",
            "description": "Details when there is no suggestion."
          }
        },
        "required": [
          "segmentId",
          "originalText",
          "suggestedText"
        ]
      },
      "description": "One suggestion per requested segment."
    }
  },
  "required": [
    "suggestions"
  ]
}
