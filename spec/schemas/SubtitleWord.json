{
  "type": "object",
  "required": [
    "word",
    "time_begin",
    "time_end"
  ],
  "properties": {
    "word": {
      "type": "string",
      "description": "Word text, at most 500 characters.",
      "maxLength": 500
    },
    "time_begin": {
      "type": "number",
      "minimum": 0,
      "description": "Start time in seconds"
    },
    "time_end": {
      "type": "number",
      "minimum": 0,
      "description": "End time in seconds"
    },
    "is_eos": {
      "type": "boolean",
      "description": "Whether this word ends a sentence"
    }
  }
}
