{
  "type": "object",
  "description": "The dubbed audio of the segments in a time range.",
  "properties": {
    "segments": {
      "type": "object",
      "description": "Dubbed audio by segment id.",
      "additionalProperties": {
        "type": "object",
        "description": "One segment.",
        "properties": {
          "segmentId": {
            "type": "string",
            "description": "Segment ID."
          },
          "url": {
            "type": "string",
            "description": "Signed link to the audio of the segment.",
            "format": "uri"
          }
        },
        "required": [
          "segmentId",
          "url"
        ]
      }
    },
    "backgroundAudioUrl": {
      "type": "string",
      "description": "Signed link to the background audio.",
      "format": "uri"
    },
    "backgroundWaveformUrl": {
      "type": "string",
      "description": "Signed link to the waveform of the background audio.",
      "format": "uri"
    },
    "useNewDubbing": {
      "type": "boolean",
      "description": "True when the dubbing supports the segment audio edits."
    },
    "timeRange": {
      "type": "object",
      "description": "The range that was read.",
      "properties": {
        "startTime": {
          "type": "number",
          "description": "Start in seconds."
        },
        "endTime": {
          "type": "number",
          "description": "End in seconds."
        },
        "totalSegments": {
          "type": "integer",
          "description": "Segments in the dubbing."
        },
        "segmentsInRange": {
          "type": "integer",
          "description": "Segments in the range."
        }
      }
    }
  },
  "required": [
    "segments",
    "useNewDubbing"
  ]
}
