{
  "type": "object",
  "description": "A pronunciation set applied to a project for one language.",
  "properties": {
    "id": {
      "type": "string",
      "description": "Pronunciation set ID.",
      "format": "uuid"
    },
    "name": {
      "type": "string",
      "description": "Pronunciation set name."
    },
    "languageCode": {
      "type": "string",
      "description": "Language the set is applied to."
    },
    "items": {
      "type": "array",
      "description": "Pronunciation pairs.",
      "items": {
        "type": "object",
        "description": "A written form and how to say it.",
        "properties": {
          "source": {
            "type": "string",
            "description": "Written form of the term."
          },
          "target": {
            "type": "string",
            "description": "How the term is pronounced."
          }
        }
      }
    }
  }
}
