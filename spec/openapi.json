    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "The same Phrase Platform API token as `Authorization: Bearer <token>`. Use either this or `X-API-Key`, not both. Errors are the same: `401` for a token that is missing, invalid or expired, `403` for an action that is not allowed."
      },
      "apiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key",
        "description": "Your Phrase Platform API token in the `X-API-Key` header. A missing, invalid or expired token is answered with `401`. `403` means the token is valid but the action is not allowed for it."
      }
    },
