{
  "name": "phrase-studio-openapi",
  "version": "1.0.0",
  "private": true,
  "description": "OpenAPI specification of the Phrase Studio public API",
  "type": "module",
  "scripts": {
    "bundle": "node scripts/bundle.mjs",
    "lint": "redocly lint schemas/projects.json && node scripts/check-spec-rules.mjs",
    "check:generated": "node scripts/check-generated.mjs",
    "test": "node --test \"scripts/**/*.test.mjs\"",
    "validate": "npm run bundle && npm run lint && npm test"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "@redocly/cli": "2.72.0"
  }
}
